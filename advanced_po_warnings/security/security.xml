<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_po_warnings" model="ir.module.category">
        <field name="name">Purchase Order Warnings</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_po_warning_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_category_po_warnings"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Reviews purchase orders blocked by advanced warnings: bypass and confirm, or reject.</field>
    </record>

    <record id="purchase_order_warning_company_rule" model="ir.rule">
        <field name="name">Purchase Order Warning: multi-company</field>
        <field name="model_id" ref="model_purchase_order_warning"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
