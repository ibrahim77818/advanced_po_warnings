<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_po_warnings" model="ir.ui.view">
        <field name="name">purchase.order.form.po.warnings</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@id='draft_confirm']" position="after">
                <button name="action_open_po_warning_review" type="object" string="Review Warnings"
                        class="oe_highlight" icon="fa-gavel"
                        groups="advanced_po_warnings.group_po_warning_supervisor"
                        attrs="{'invisible': [('po_review_state', '!=', 'blocked')]}"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="po_review_state" invisible="1"/>
                <field name="po_warning_preview_level" invisible="1"/>
                <div class="alert alert-danger mb-0 o_po_warning_banner" role="alert"
                     attrs="{'invisible': [('po_review_state', '!=', 'blocked')]}">
                    <i class="fa fa-ban me-2" role="img" aria-label="Blocked" title="Blocked"/>
                    <strong>Confirmation blocked.</strong>
                    This order triggered blocking warnings and is waiting for a supervisor review.
                    See the <em>Order Warnings</em> tab.
                </div>
                <div class="alert alert-warning mb-0 o_po_warning_banner" role="alert"
                     attrs="{'invisible': ['|', ('po_warning_preview_level', '!=', 'warning'), ('po_review_state', '=', 'blocked')]}">
                    <field name="po_warning_preview" nolabel="1" readonly="1"/>
                </div>
                <div class="alert alert-danger mb-0 o_po_warning_banner" role="alert"
                     attrs="{'invisible': ['|', ('po_warning_preview_level', '!=', 'block'), ('po_review_state', '=', 'blocked')]}">
                    <field name="po_warning_preview" nolabel="1" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Blocked" bg_color="bg-danger"
                        attrs="{'invisible': [('po_review_state', '!=', 'blocked')]}"/>
                <widget name="web_ribbon" title="Rejected" bg_color="bg-danger"
                        attrs="{'invisible': [('po_review_state', '!=', 'rejected')]}"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Order Warnings" name="po_warnings"
                      attrs="{'invisible': [('po_warning_ids', '=', []), ('po_review_state', '=', 'none')]}">
                    <field name="po_warning_ids" readonly="1">
                        <tree decoration-danger="mode == 'block'" decoration-warning="mode == 'warning'">
                            <field name="rule"/>
                            <field name="mode" widget="badge"
                                   decoration-danger="mode == 'block'" decoration-warning="mode == 'warning'"/>
                            <field name="message"/>
                            <field name="product_id" optional="show"/>
                            <field name="location_id" optional="hide"/>
                            <field name="warehouse_id" optional="hide"/>
                            <field name="conflict_order_ids" widget="many2many_tags"/>
                        </tree>
                    </field>
                    <group name="po_review" string="Supervisor Review"
                           attrs="{'invisible': [('po_review_state', 'in', ('none', 'blocked'))]}">
                        <group>
                            <field name="po_review_state" widget="badge"
                                   decoration-success="po_review_state == 'bypassed'"
                                   decoration-danger="po_review_state == 'rejected'"/>
                            <field name="po_reviewed_by_id"/>
                            <field name="po_reviewed_date"/>
                        </group>
                        <group>
                            <field name="po_review_note"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_po_warnings" model="ir.ui.view">
        <field name="name">purchase.order.tree.po.warnings</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="po_review_state" widget="badge" optional="show"
                       decoration-danger="po_review_state in ('blocked', 'rejected')"
                       decoration-success="po_review_state == 'bypassed'"
                       attrs="{'invisible': [('po_review_state', '=', 'none')]}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_tree_po_warnings" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.po.warnings</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="before">
                <field name="po_review_state" widget="badge" optional="show"
                       decoration-danger="po_review_state in ('blocked', 'rejected')"
                       decoration-success="po_review_state == 'bypassed'"
                       attrs="{'invisible': [('po_review_state', '=', 'none')]}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_search_po_warnings" model="ir.ui.view">
        <field name="name">purchase.order.search.po.warnings</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='invoiced']" position="after">
                <separator/>
                <filter name="po_warning_blocked" string="Blocked by Warnings"
                        domain="[('po_review_state', '=', 'blocked')]"/>
                <filter name="po_warning_bypassed" string="Warnings Bypassed"
                        domain="[('po_review_state', '=', 'bypassed')]"/>
                <filter name="po_warning_rejected" string="Rejected by Supervisor"
                        domain="[('po_review_state', '=', 'rejected')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="groupby_po_review_state" string="Warning Review"
                        context="{'group_by': 'po_review_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- The RFQ list uses its own search view: add the same filters there. -->
    <record id="purchase_rfq_search_po_warnings" model="ir.ui.view">
        <field name="name">purchase.order.rfq.search.po.warnings</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late_rfqs']" position="after">
                <separator/>
                <filter name="po_warning_blocked" string="Blocked by Warnings"
                        domain="[('po_review_state', '=', 'blocked')]"/>
                <filter name="po_warning_bypassed" string="Warnings Bypassed"
                        domain="[('po_review_state', '=', 'bypassed')]"/>
                <filter name="po_warning_rejected" string="Rejected by Supervisor"
                        domain="[('po_review_state', '=', 'rejected')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="groupby_po_review_state" string="Warning Review"
                        context="{'group_by': 'po_review_state'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_po_warning_blocked_orders" model="ir.actions.act_window">
        <field name="name">Blocked Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="purchase.purchase_order_view_tree"/>
        <field name="search_view_id" ref="purchase.purchase_order_view_search"/>
        <field name="domain">[('po_review_state', '=', 'blocked')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No purchase order is waiting for a review</p>
            <p>Orders blocked by advanced warnings appear here until a supervisor bypasses or rejects them.</p>
        </field>
    </record>

    <menuitem id="menu_po_warning_blocked_orders" name="Blocked Orders"
              parent="purchase.menu_procurement_management"
              action="action_po_warning_blocked_orders" sequence="25"
              groups="advanced_po_warnings.group_po_warning_supervisor"/>
</odoo>
