<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Alerts shared by the form preview, chatter messages and review activities.
         The preview banner spans the full form width and uses a table; chatter notes and
         activities are rendered as a stacked list, because Odoo 19 shows the chatter in a
         narrow side panel on common screen widths.
         Logical (start/end) alignment classes only, so everything mirrors in RTL. -->
    <template id="po_warning_alerts">
        <div class="o_po_warning_alerts">
            <p t-if="title" class="mb-2"><strong t-out="title"/></p>
            <t t-if="context == 'preview'">
                <p t-if="blocking" class="mb-2">
                    This order will be blocked on confirmation and sent to a supervisor for review.
                </p>
                <p t-else="" class="mb-2">
                    This order can be confirmed, but the following warnings will be recorded.
                </p>
                <table class="table table-sm o_po_warning_table mb-0">
                    <thead>
                        <tr>
                            <th class="text-start">Rule</th>
                            <th class="text-start">Enforcement</th>
                            <th class="text-start">Alert</th>
                            <th class="text-start">Related Orders</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="rows" t-as="row">
                            <td class="text-start text-nowrap" t-out="row['rule']"/>
                            <td class="text-start text-nowrap">
                                <span t-attf-class="badge rounded-pill #{'text-bg-danger' if row['mode'] == 'block' else 'text-bg-warning'}"
                                      t-out="row['mode_label']"/>
                            </td>
                            <td class="text-start" t-out="row['message']"/>
                            <td class="text-start">
                                <t t-call="advanced_po_warnings.po_warning_conflict_links"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
            <ul t-else="" class="list-unstyled mb-0 o_po_warning_list">
                <li t-foreach="rows" t-as="row" t-attf-class="text-start #{'' if row_last else 'mb-2'}">
                    <div>
                        <span t-attf-class="badge rounded-pill me-1 #{'text-bg-danger' if row['mode'] == 'block' else 'text-bg-warning'}"
                              t-out="row['mode_label']"/>
                        <strong t-out="row['rule']"/>
                    </div>
                    <div t-out="row['message']"/>
                    <div t-if="row['conflicts']" class="text-muted small">
                        <span>Related Orders</span>:
                        <t t-call="advanced_po_warnings.po_warning_conflict_links"/>
                    </div>
                </li>
            </ul>
        </div>
    </template>

    <template id="po_warning_conflict_links">
        <t t-foreach="row['conflicts']" t-as="conflict">
            <a t-attf-href="/odoo/purchase.order/#{conflict.id}"
               data-oe-model="purchase.order" t-att-data-oe-id="conflict.id"
               t-out="conflict.name"/><t t-if="not conflict_last">, </t>
        </t>
    </template>
</odoo>
